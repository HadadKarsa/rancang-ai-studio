# ─── Core ───────────────────────────────────────────────
APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Database ───────────────────────────────────────────
DATABASE_URL=file:./data/rancang.db
DATABASE_AUTH_TOKEN=            # required only for Turso

# ─── Auth ───────────────────────────────────────────────
AUTH_MODE=local                 # local | cloud (cloud enforces login on all app routes)
AUTH_SECRET=                    # openssl rand -base64 32 (required when AUTH_MODE=cloud)
# Google OAuth 2.0 (v0.2.6) - register redirect URI: ${APP_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Encryption ─────────────────────────────────────────
ENCRYPTION_KEY=                 # 32-byte base64: openssl rand -base64 32

# ─── Local Default User ─────────────────────────────────
LOCAL_USER_EMAIL=owner@rancang.local
LOCAL_USER_NAME=Local Owner

# ─── Managed Default Model (optional, v0.2.5) ───────────
# Server-owned OpenAI-compatible provider offered as "Bawaan Rancang.ai".
# Secrets stay on the server and are never sent to the browser.
MANAGED_LABEL=Rancang.ai
MANAGED_BASE_URL=
MANAGED_API_KEY=
MANAGED_MODELS=                 # comma-separated allowlist, e.g. deepseek-v4-1-flash,deepseek-v4-1-chat
MANAGED_DEFAULT_MODEL=          # optional; defaults to the first entry in MANAGED_MODELS
