# ─── Core ───────────────────────────────────────────────
APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Database ───────────────────────────────────────────
DATABASE_URL=file:./data/rancang.db
DATABASE_AUTH_TOKEN=            # required only for Turso

# ─── Auth ───────────────────────────────────────────────
AUTH_MODE=local                 # local | cloud
AUTH_SECRET=                    # openssl rand -base64 32
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_EMAIL_SERVER=              # SMTP URL for magic links (cloud only)
AUTH_EMAIL_FROM=noreply@rancang.ai

# ─── Encryption ─────────────────────────────────────────
ENCRYPTION_KEY=                 # 32-byte base64: openssl rand -base64 32

# ─── Local Default User ─────────────────────────────────
LOCAL_USER_EMAIL=owner@rancang.local
LOCAL_USER_NAME=Local Owner
