{
  "name": "rancang-ai",
  "version": "0.2.4",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -rf data && pnpm db:migrate && pnpm db:seed",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.106",
    "@ai-sdk/google": "^4.0.122",
    "@ai-sdk/groq": "^4.0.85",
    "@ai-sdk/openai": "^4.0.121",
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "ai": "^7.0.176",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "mermaid": "^12.3.0",
    "nanoid": "^6.0.2",
    "next": "15",
    "react": "19",
    "react-dom": "19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.1.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
